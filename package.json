{
  "name": "vibe-gx",
  "version": "4.3.0",
  "description": "A lightweight, high-performance Node.js web framework.",
  "type": "module",
  "main": "vibe.js",
  "types": "vibe.d.ts",
  "exports": {
    ".": {
      "types": "./vibe.d.ts",
      "import": "./vibe.js",
      "require": "./dist/vibe.cjs"
    }
  },
  "files": [
    "vibe.js",
    "vibe.d.ts",
    "utils/",
    "dist/"
  ],
  "scripts": {
    "build": "esbuild vibe.js --bundle --platform=node --format=cjs --outfile=dist/vibe.cjs --packages=external",
    "test": "node tests/unit.test.js && node tests/live.test.js",
    "test:all": "node tests/unit.test.js && node tests/live.test.js && node tests/scalability.test.js",
    "benchmark": "node tests/full-benchmark.js",
    "start": "node server.js"
  },
  "keywords": [
    "node",
    "framework",
    "http",
    "router",
    "middleware",
    "web",
    "backend",
    "fast",
    "performance",
    "express-alternative"
  ],
  "author": "Nnamdi \"Joe\" Amaga",
  "license": "MIT",
  "dependencies": {
    "busboy": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
